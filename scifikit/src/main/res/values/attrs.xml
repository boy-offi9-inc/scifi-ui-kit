<?xml version="1.0" encoding="utf-8"?>
<resources>

    <declare-styleable name="HudFrameView">
        <attr name="sfAccentColor" format="color" />
        <attr name="sfFillColor" format="color" />
        <attr name="sfChamfer" format="dimension" />
        <attr name="sfStrokeWidth" format="dimension" />
        <attr name="sfBracketLength" format="dimension" />
        <attr name="sfScanlines" format="boolean" />
        <attr name="sfSweep" format="boolean" />
    </declare-styleable>

    <declare-styleable name="GlitchTextView">
        <attr name="android:text" />
        <attr name="android:textSize" />
        <attr name="android:textColor" />
        <attr name="sfSplitColorA" format="color" />
        <attr name="sfSplitColorB" format="color" />
        <attr name="sfIntensity" format="float" />
        <attr name="sfGlitchIntervalMs" format="integer" />
        <attr name="sfGlitchMode">
            <enum name="subtle" value="0" />
            <enum name="standard" value="1" />
            <enum name="violent" value="2" />
            <enum name="signalLoss" value="3" />
            <enum name="onTouch" value="4" />
        </attr>
        <attr name="sfBurstDurationMs" format="integer" />
        <attr name="sfGlitchJitter" format="float" />
        <attr name="sfGlitchStrips" format="integer" />
        <attr name="sfGlitchSliceChance" format="float" />
        <attr name="sfGlitchSliceReach" format="float" />
        <attr name="sfGlitchDropout" format="float" />
        <attr name="sfGlitchFlicker" format="float" />
        <attr name="sfTouchMode">
            <enum name="burst" value="0" />
            <enum name="follow" value="1" />
            <enum name="charge" value="2" />
            <enum name="followCharge" value="3" />
        </attr>
        <attr name="sfTouchRadius" format="float" />
        <attr name="sfChargeMs" format="integer" />
        <attr name="sfChargeBoost" format="float" />
        <attr name="sfDecodeDurationMs" format="integer" />
        <attr name="sfDecodeMode">
            <enum name="classic" value="0" />
            <enum name="relaxed" value="1" />
            <enum name="active" value="2" />
            <enum name="random" value="3" />
            <enum name="centerOut" value="4" />
            <enum name="typewriter" value="5" />
        </attr>
        <attr name="sfDecodeOrder">
            <enum name="leftToRight" value="0" />
            <enum name="rightToLeft" value="1" />
            <enum name="centerOut" value="2" />
            <enum name="random" value="3" />
        </attr>
        <attr name="sfDecodeCharset" format="string" />
        <attr name="sfDecodeSwapMs" format="integer" />
        <attr name="sfDecodeShimmer" format="float" />
        <attr name="sfDecodeScramble" format="boolean" />
        <attr name="sfDecodeCursor" format="boolean" />
    </declare-styleable>

    <declare-styleable name="SciFiCardView">
        <attr name="sfAccentColor" />
        <attr name="sfStrokeWidth" />
        <attr name="sfCardStyle">
            <enum name="panel" value="0" />
            <enum name="outline" value="1" />
            <enum name="plain" value="2" />
        </attr>
        <attr name="sfCardCut" format="dimension" />
        <attr name="sfCardFill" format="float" />
        <attr name="sfCardGrid" format="float" />
        <attr name="sfCardGlow" format="float" />
        <attr name="sfCardMarch" format="float" />
    </declare-styleable>

    <declare-styleable name="HoloRadarView">
        <!-- Shared with HudFrameView, declared once there -->
        <attr name="sfAccentColor" />
        <attr name="sfStrokeWidth" />
        <attr name="sfSweep" />
        <attr name="sfRings" format="integer" />
        <attr name="sfRotationPeriodMs" format="integer" />
        <attr name="sfBlipCount" format="integer" />
        <attr name="sfRadarMode">
            <enum name="classic" value="0" />
            <enum name="tactical" value="1" />
            <enum name="cyberpunk" value="2" />
            <enum name="phosphor" value="3" />
            <enum name="hologram" value="4" />
        </attr>
        <attr name="sfRadarTrailDeg" format="float" />
        <attr name="sfRadarGlow" format="float" />
        <attr name="sfRadarFlicker" format="float" />
        <attr name="sfRadarScanlines" format="boolean" />
        <attr name="sfRadarSecondaryColor" format="color" />
    </declare-styleable>


    <declare-styleable name="NeonButtonView">
        <attr name="android:text" />
        <attr name="android:textSize" />
        <attr name="android:textColor" />
        <attr name="sfAccentColor" />
        <attr name="sfStrokeWidth" />
        <attr name="sfOnAccentColor" format="color" />
        <attr name="sfNeonStyle">
            <enum name="outline" value="0" />
            <enum name="solid" value="1" />
            <enum name="ghost" value="2" />
        </attr>
        <attr name="sfNeonFill" format="float" />
        <attr name="sfNeonGlow" format="float" />
        <attr name="sfNeonPulse" format="float" />
        <attr name="sfNeonSurge" format="float" />
        <attr name="sfNeonFlicker" format="float" />
        <attr name="sfNeonSurgeMs" format="integer" />
        <attr name="sfNeonCorner" format="float" />
    </declare-styleable>

    <declare-styleable name="NeonProgressView">
        <attr name="sfLabel" format="string" />
        <attr name="sfProgress" format="float" />
        <attr name="sfWarningAt" format="float" />
        <attr name="sfTicks" format="integer" />
        <attr name="sfShowPercent" format="boolean" />
        <attr name="sfAccentColor" />
        <attr name="sfWarningColor" format="color" />
    </declare-styleable>

    <declare-styleable name="NeonBadgeView">
        <attr name="sfText" format="string" />
        <attr name="sfState">
            <enum name="normal" value="0" />
            <enum name="success" value="1" />
            <enum name="warning" value="2" />
            <enum name="danger" value="3" />
            <enum name="muted" value="4" />
        </attr>
        <attr name="sfFilled" format="boolean" />
        <attr name="sfDot" format="boolean" />
        <attr name="sfAccentColor" />
    </declare-styleable>

    <declare-styleable name="NeonGaugeView">
        <attr name="sfGaugeValue" format="float" />
        <attr name="sfGaugeValue2" format="float" />
        <attr name="sfUnit" format="string" />
        <attr name="sfReadout">
            <enum name="percent" value="0" />
            <enum name="value" value="1" />
            <enum name="none" value="2" />
        </attr>
        <attr name="sfGaugeSweep" format="float" />
        <attr name="sfGaugeTicks" format="integer" />
        <attr name="sfGaugeWarningAt" format="float" />
        <attr name="sfAccentColor" />
    </declare-styleable>

    <declare-styleable name="NeonAlertView">
        <attr name="sfAlertText" format="string" />
        <attr name="sfSeverity">
            <enum name="info" value="0" />
            <enum name="success" value="1" />
            <enum name="warning" value="2" />
            <enum name="danger" value="3" />
        </attr>
        <attr name="sfAlertFilled" format="boolean" />
        <attr name="sfAlertIcon" format="boolean" />
        <attr name="sfAlertChevrons" format="boolean" />
        <attr name="sfAlertHazard" format="float" />
        <attr name="sfAccentColor" />
    </declare-styleable>

    <declare-styleable name="SciFiTheme">
        <attr name="sfThemeAccent" format="color" />
        <attr name="sfThemeSecondary" format="color" />
        <attr name="sfThemeText" format="color" />
        <attr name="sfThemeDim" format="color" />
        <attr name="sfThemeBackground" format="color" />
        <attr name="sfThemeGlow" format="float" />
    </declare-styleable>
</resources>
